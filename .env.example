# Bu dosyayı ".env" olarak kopyala ve değerleri doldur.

# Anthropic (Claude) API anahtarı — https://console.anthropic.com/ > API Keys
ANTHROPIC_API_KEY=

# Supabase proje bilgileri — Supabase panelinde:
# Project Settings > Data API (URL)  ve  API Keys (Secret key / service_role)
# DİKKAT: bu anahtar gizli tutulmalı, asla tarayıcıya/istemciye koyma.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# İsteğe bağlı: model (varsayılan claude-opus-4-8)
MODEL=claude-sonnet-5

# Voyage AI — konuşmaları "duruma göre" bulmak için embedding (RAG).
# Anahtar: https://dashboard.voyageai.com/ > API Keys
VOYAGE_API_KEY=
# İsteğe bağlı: model ve boyut (varsayılan voyage-3.5 / 1024).
# EMBED_DIM değiştirirsen schema.sql'deki vector(1024) ile eşitle ve yeniden gömle.
EMBED_MODEL=voyage-3.5
EMBED_DIM=1024

# --- Instagram DM (npm run instagram) ---------------------------------------
# Hepsi https://developers.facebook.com > uygulaman > Instagram / App Settings
# Kurulum adımları için README > "Instagram DM entegrasyonu".

# Instagram hesabının uzun ömürlü erişim anahtarı (Instagram > API setup).
IG_ACCESS_TOKEN=
# App Settings > Basic > App Secret. Webhook imzasını doğrulamak için ŞART.
IG_APP_SECRET=
# Kendi uydurduğun bir parola. Meta'daki "Verify token" alanına aynısını yaz.
IG_VERIFY_TOKEN=

# --- Telegram kumandası (opsiyonel ama tavsiye edilir) ----------------------
# Müşteri mesajları buraya düşer; /pause - /resume ile ikizi yönetirsin.
# Tünel gerekmiyor. Token: Telegram'da @BotFather > /newbot
TELEGRAM_BOT_TOKEN=
# Sadece bu sohbet komut verebilir. Bilmiyorsan boş bırak: sunucuyu çalıştırıp
# botuna bir mesaj yaz, konsol chat id'yi yazacak.
TELEGRAM_CHAT_ID=

# İsteğe bağlı ayarlar (varsayılanlar yeterli):
# WEBHOOK_PORT=3940
# IG_AUTO_REPLY=true            # false yaparsan ikiz hiç cevap yazmaz (sadece kaydeder)
# IG_HISTORY_LIMIT=20           # Claude'a taşınan geçmiş mesaj sayısı
# Mesaj biriktirme: müşteri sustuktan sonra bu aralıkta rastgele bekler,
# bu sürede gelen tüm mesajları birden okuyup TEK cevap yazar.
# IG_WAIT_MIN_SEC=45
# IG_WAIT_MAX_SEC=90
# IG_WAIT_CEILING_SEC=300       # müşteri hiç susmazsa en geç ne zaman cevap versin
# IG_TYPING_MIN_SEC=5           # göndermeden önce "yazıyor..." süresi
# IG_TYPING_MAX_SEC=20
# IG_ACCOUNT_ID=me              # başka bir hesap adına gönderiyorsan onun ID'si
# IG_GRAPH_HOST=graph.instagram.com   # Facebook Login kurulumunda graph.facebook.com
# IG_GRAPH_VERSION=v23.0
